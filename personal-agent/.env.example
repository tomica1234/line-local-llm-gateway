PERSONAL_AGENT_HOST=127.0.0.1
PERSONAL_AGENT_PORT=8787
PERSONAL_AGENT_DB_PATH=./data/personal-agent.sqlite3
PERSONAL_AGENT_USER_ID=primary
PERSONAL_AGENT_TIMEZONE=Asia/Tokyo
PERSONAL_AGENT_RAW_EVENT_RETENTION_DAYS=90

# OpenAI-compatible local Qwen endpoint. Remote hosts are rejected by default.
PERSONAL_AGENT_MODEL_BASE_URL=http://127.0.0.1:8000/v1
PERSONAL_AGENT_MODEL_NAME=Qwen3.6-35B-A3B
PERSONAL_AGENT_MODEL_API_KEY=replace-with-a-different-32-character-model-token
PERSONAL_AGENT_MODEL_TIMEOUT_SECONDS=120
# Qwen 3.6の思考モードは長い推論で回答が途切れやすいため、通常運用では無効化する。
PERSONAL_AGENT_MODEL_ENABLE_THINKING=false
PERSONAL_AGENT_ALLOW_REMOTE_MODEL=false

# WSL llama.cpp runtime used by scripts/start-qwen.sh. The selected artifact is
# Unsloth UD-Q4_K_XL; the launcher fixes --n-cpu-moe to 40.
PERSONAL_AGENT_LLAMA_SERVER_BIN=llama-server
PERSONAL_AGENT_QWEN_MODEL_PATH=./models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
PERSONAL_AGENT_QWEN_MODEL_SHA256=707a55a8a4397ecde44de0c499d3e68c1ad1d240d1da65826b4949d1043f4450
PERSONAL_AGENT_QWEN_CONTEXT_SIZE=32768
PERSONAL_AGENT_QWEN_VERIFY_SHA256=true

# iPhone PWA / Face ID passkey. Use the exact HTTPS hostname exposed by the
# private reverse proxy (for example Tailscale Serve); do not use a raw IP.
PERSONAL_AGENT_WEBAUTHN_RP_ID=
PERSONAL_AGENT_WEBAUTHN_ORIGIN=
PERSONAL_AGENT_WEBAUTHN_RP_NAME="Personal Agent"
PERSONAL_AGENT_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
PERSONAL_AGENT_WEBAUTHN_SESSION_TTL_HOURS=12
# Tailscale Serveが付与するTailscale-User-Loginを完全一致で許可する。
PERSONAL_AGENT_TAILSCALE_ALLOWED_USERS=you@example.com
# Coreを100.64.0.0/10へ直接bindする例外構成だけで必須。通常のloopback proxyでは空にする。
# 形式: 100.64.0.10=you@example.com,100.64.0.11=you@example.com
PERSONAL_AGENT_TAILSCALE_PEER_IDENTITIES=
# loopback以外の一般APIは、上記identityに加えてpasskey sessionを要求する。
PERSONAL_AGENT_REQUIRE_REMOTE_PASSKEY=true

# Required for R5 lock/policy mutations from the Web UI/API.
PERSONAL_AGENT_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Random token shared only with the Safari Activity extension.
PERSONAL_AGENT_ACTIVITY_TOKEN=replace-with-a-different-32-character-token

# Shared only by Core and the Windows Playwright Worker. Keep both services on loopback.
PERSONAL_AGENT_BROWSER_WORKER_URL=http://wsl-host:18790/v1
PERSONAL_AGENT_BROWSER_WORKER_TOKEN=replace-with-a-long-random-token
PERSONAL_AGENT_BROWSER_WORKER_TIMEOUT_SECONDS=45
PERSONAL_AGENT_ALLOW_REMOTE_BROWSER_WORKER=true

# Optional local file roots separated by the platform path separator (`;` on Windows).
# Only files below these roots are exposed; SSH keys and credential files are denied.
PERSONAL_AGENT_FILES_ROOTS=
PERSONAL_AGENT_FILES_TRASH_ROOT=./data/files-trash
PERSONAL_AGENT_DATABASE_QUOTA_BYTES=2147483648
PERSONAL_AGENT_TRASH_QUOTA_BYTES=1073741824

# Optional Home Assistant adapter. Public Internet endpoints are rejected.
PERSONAL_AGENT_HOME_ASSISTANT_URL=http://homeassistant.local:8123
PERSONAL_AGENT_HOME_ASSISTANT_TOKEN=
# Comma-separated scene IDs reviewed to contain only low-risk actions.
PERSONAL_AGENT_HOME_ASSISTANT_SAFE_SCENES=

# Slack/Gmail OAuth or API tokens stay in the Windows Secret Store. Core holds only refs.
PERSONAL_AGENT_SLACK_CREDENTIAL_ID=
PERSONAL_AGENT_GMAIL_CREDENTIAL_ID=

# Browser Worker process settings (Windows).
PERSONAL_AGENT_BROWSER_WORKER_HOST=0.0.0.0
PERSONAL_AGENT_BROWSER_WORKER_PORT=18790
# Windows Worker accepts only clients from the WSL virtual network, in addition
# to the unguessable worker token. Do not include Wi-Fi or Tailscale CIDRs.
PERSONAL_AGENT_BROWSER_ALLOWED_CLIENT_CIDRS=172.16.0.0/12
PERSONAL_AGENT_BROWSER_PROFILE_ROOT=./data/browser-profiles
PERSONAL_AGENT_BROWSER_QUARANTINE_ROOT=./data/browser-downloads
PERSONAL_AGENT_BROWSER_STATE_DB=./data/browser-worker.sqlite3
PERSONAL_AGENT_BROWSER_CHANNEL=chrome
PERSONAL_AGENT_BROWSER_HEADLESS=false
PERSONAL_AGENT_BROWSER_FINANCE_ALLOWLIST=
PERSONAL_AGENT_BROWSER_UPLOAD_ROOTS=
# Development/test only. Keep false so web content cannot reach localhost/LAN services.
PERSONAL_AGENT_BROWSER_ALLOW_PRIVATE_NAVIGATION=false
PERSONAL_AGENT_BROWSER_TAKEOVER_TIMEOUT_SECONDS=300
PERSONAL_AGENT_BROWSER_NAVIGATION_TIMEOUT_MS=30000
PERSONAL_AGENT_BROWSER_CORE_URL=http://127.0.0.1:8787
PERSONAL_AGENT_BROWSER_ALLOW_NON_WINDOWS=false
PERSONAL_AGENT_SECRET_DB_PATH=./data/secrets.sqlite3

# Non-Windows only: externally supplied urlsafe-base64 encoding of 32 random bytes.
# Windows uses user-scoped DPAPI and does not need this key.
PERSONAL_AGENT_SECRET_MASTER_KEY=

# LINE Messaging API (optional). Use scripts/configure-line.py so secrets are not
# exposed in shell history. Only the exact signed webhook path may be public.
PERSONAL_AGENT_LINE_CHANNEL_SECRET=
PERSONAL_AGENT_LINE_CHANNEL_ACCESS_TOKEN=
PERSONAL_AGENT_LINE_PRIMARY_USER_ID=

# Optional Windows LINE Desktop OCR bridge. The bridge stays on Windows loopback,
# never reads LINE's encrypted database, and never persists screenshots.
PERSONAL_AGENT_LINE_DESKTOP_BRIDGE_URL=http://127.0.0.1:18791/v1
PERSONAL_AGENT_LINE_DESKTOP_BRIDGE_TOKEN=
PERSONAL_AGENT_LINE_DESKTOP_BRIDGE_TIMEOUT_SECONDS=20
PERSONAL_AGENT_LINE_DESKTOP_SYNC_INTERVAL_SECONDS=60
# Keep false until exact conversation IDs are allowlisted in the Windows bridge.
PERSONAL_AGENT_LINE_DESKTOP_SEND_ENABLED=false
PERSONAL_AGENT_ALLOW_REMOTE_LINE_DESKTOP_BRIDGE=false
